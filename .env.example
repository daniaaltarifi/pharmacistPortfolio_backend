NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (portfolio + admin dashboard)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Supabase Dashboard -> Connect -> Session pooler (replace [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Secret used to sign login tokens (JWT). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Supabase Storage for image uploads (Dashboard -> Project Settings -> API Keys)
# Service role / secret key: server-only, never put it in the React app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=images

# Outgoing email for replying to contact messages from the dashboard.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS = a Google "App Password" (not your normal password).
# MAIL_TRANSPORT=log prints emails to the server console instead of sending them (local testing).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Dr. Your Name <you@gmail.com>
MAIL_REPLY_TO=
MAIL_TRANSPORT=
