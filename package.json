  "version": "0.1.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node --env-file-if-exists=.env server.js",
    "db:sync": "node --env-file-if-exists=.env scripts/db-sync.js",
